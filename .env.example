# ── AI ────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Database ──────────────────────────────────────────────────────
# SQLite (default, good for getting started):
DATABASE_URL=sqlite:///./brains_college.db
# PostgreSQL on Render (recommended for production):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Security ──────────────────────────────────────────────────────
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma separated list of allowed frontend origins ("*" = any)
ALLOWED_ORIGINS=*

# ── First super admin (created automatically on first startup) ───
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@brainscollege.edu.pk
SUPER_ADMIN_PASSWORD=Admin@123

# ── Misc ──────────────────────────────────────────────────────────
TIMEZONE=Asia/Karachi

# ── REMOVED (no longer used — delete from Render) ────────────────
# GOOGLE_CREDENTIALS
# GOOGLE_SHEET_ID

